{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rewind Music Player",
  "version": "1.2.0",
  "identifier": "com.rewind.musicplayer",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rewind Music Player",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "center": true
      },
      {
        "label": "mini",
        "title": "Rewind Mini Player",
        "url": "mini/",
        "width": 300,
        "height": 300,
        "minWidth": 280,
        "minHeight": 280,
        "maxWidth": 340,
        "maxHeight": 340,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "transparent": true,
        "center": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$AUDIO/**", "$DOWNLOAD/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
