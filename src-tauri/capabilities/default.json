{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables permissions for Rewind Music Player",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "shell:default",
    "shell:allow-open",
    "shell:allow-execute",
    "dialog:default",
    "process:default",
    "fs:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/yt-dlp",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/yt-dlp",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
